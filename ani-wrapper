#!/bin/sh
# Entry point for the Animeko Flatpak.
#
# The app tree is not part of this Flatpak: flatpak downloaded the upstream
# AppImage and apply_extra unpacked it into /app/extra/ani at install time.
#
# Mirrors the AppImage's AppRun without exporting LD_LIBRARY_PATH: the jpackage
# launcher already appends its own app directory to LD_LIBRARY_PATH (which is
# what feeds java.library.path for libanitorrent, libmediampv and Skiko), and
# overwriting the value Flatpak sets up can break loading of runtime libraries.
set -eu

# The bundled CEF (Chrome 137) aborts its unzip utility process with
# "*** stack smashing detected ***" every time Chromium's component updater
# unpacks a component: Chromium's content layer re-randomises the stack canary
# in every zygote child (CEF passes it --change-stack-guard-on-fork=enable), and
# CEF's own CefExecuteProcess() - still on the stack across that fork - is not
# built with NO_STACK_PROTECTOR, so its canary check fails (CEF issue #3912). It
# is harmless - the updater retries and the components do install - but each
# SIGABRT costs a ~110 MB core dump and makes KDE's crash reporter notify (one
# burst was 24 aborts in 53 seconds).
#
# RLIMIT_CORE 0 does not stop that reporting: the kernel only applies the limit
# to file dumps, so with the systemd pipe pattern it still runs
# systemd-coredump, which logs the abort and hands it to drkonqi - a crash
# notification with no core behind it. A limit of exactly 1 byte is the kernel's
# sentinel for a recursive dump: it abandons the dump before the pipe helper is
# started at all. ulimit cannot express 1 (its unit is blocks), hence prlimit.
#
# To keep cores while debugging, e.g.:
#   flatpak run --env=ANIMEKO_FLATPAK_KEEP_CORES=1 me.him188.ani
if [ "${ANIMEKO_FLATPAK_KEEP_CORES:-0}" != "1" ]; then
    prlimit --core=1:1 --pid $$ 2>/dev/null || ulimit -c 0
fi

APPDIR=/app/extra/ani
export APPDIR
export PATH="$APPDIR/usr/bin:$PATH"
export XDG_DATA_DIRS="$APPDIR/usr/share${XDG_DATA_DIRS:+:$XDG_DATA_DIRS}"

# The playback screen's screenshot button hands mpv a bare filename, so mpv's
# `screenshot-to-file` and the native surface readback write it relative to the
# process working directory. flatpak starts the app with cwd set to $HOME, and
# in the sandbox that $HOME is a per-run tmpfs (only .config, .local and .var),
# thrown away on exit - a screenshot written there would never reach the disk.
# chdir into a persistent directory first, so the file lands in
# ~/.var/app/me.him188.ani/data/ani/screenshots/ on the host.
screenshots="${XDG_DATA_HOME:-$HOME/.var/app/me.him188.ani/data}/ani/screenshots"
mkdir -p "$screenshots"
cd "$screenshots"

exec "$APPDIR/usr/bin/Ani" "$@"
